# Copy this file to .env (same folder) and pick the line for where you run the app.
# Restart `npx expo start` after changing it.
#
# Web (browser on this computer):
EXPO_PUBLIC_API_URL=http://localhost:8000
#
# Android emulator (10.0.2.2 is the computer, seen from the emulator):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
#
# Real phone on the same Wi-Fi (use your computer's local IP, see `ipconfig`):
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
